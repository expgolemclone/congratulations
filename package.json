{
  "name": "@expgolemclone/congratulations",
  "version": "2.1.0",
  "type": "module",
  "exports": {
    "./celebration": "./src/contracts/celebration.mjs",
    "./feedback": "./src/feedback/index.mjs"
  },
  "files": [
    "src/contracts/celebration.mjs",
    "src/feedback",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expgolemclone/congratulations"
  },
  "scripts": {
    "build": "vite build --config vite.config.js",
    "test": "node --test tests/contracts/*.test.mjs tests/achievement/*.test.mjs tests/feedback/*.test.mjs && npm run build && node tests/achievement/smoke.mjs && node tests/achievement/browser.mjs && node tests/feedback/browser.mjs",
    "test:production": "npm run build && node --use-system-ca tests/achievement/production.mjs",
    "deploy": "npm test && wrangler deploy && npm run test:production"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261001.1": true
  },
  "devDependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@vitejs/plugin-react": "6.1.2",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
